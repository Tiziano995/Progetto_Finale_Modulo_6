# File di esempio per le variabili d'ambiente.
# ISTRUZIONI: rinomina questo file in ".env" prima di avviare il progetto.
#
# Come ottenere la chiave:
#   1. Vai su https://platform.openai.com/api-keys
#   2. Crea una nuova chiave (Secret Key)
#   3. Incollala qui sotto al posto di "sk-..."

OPENAI_API_KEY=sk-...
